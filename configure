#!/bin/sh
# This script generates a Makefile for building the server application

# Check for pthreads support
if ! printf '#include <pthread.h>\nint main(void) { return 0; }\n' | gcc -x c - -o /dev/null -lpthread 2>/dev/null; then
    echo "Error: pthreads library not found. Please install pthreads development package."
    exit 1
fi

cat << 'EOF' > Makefile
# Auto-generated Makefile

# Compiler and flags
CC = gcc
CFLAGS ?= -O3 -DNDEBUG -Wall -Wextra -g -Isrc
LDFLAGS = -lpthread

# Target to build the server executable
server: server.c src/store.c src/store.h
	$(CC) $(CFLAGS) -o server server.c src/store.c $(LDFLAGS)

client: test/client.c
	$(CC) $(CFLAGS) -o test/client test/client.c $(LDFLAGS)

tests/store_test: tests/store_test.c src/store.c src/store.h
	$(CC) $(CFLAGS) -o tests/store_test tests/store_test.c src/store.c $(LDFLAGS)

tests/perf_test: tests/perf_test.c
	$(CC) $(CFLAGS) -o tests/perf_test tests/perf_test.c -lpthread

test: tests/store_test
	./tests/store_test

smoke-test: server
	bash tests/server_smoke.sh

perf-test: server tests/perf_test
	bash tests/perf_test.sh

tests/kv_bench: tests/kv_bench.c
	$(CC) $(CFLAGS) -o tests/kv_bench tests/kv_bench.c -lpthread

network-test: server
	python3 tests/network_test.py

compare-redis: server
	python3 tests/compare_redis.py

all: server client tests/store_test tests/perf_test tests/kv_bench

# Clean target to remove the built executable
clean:
	@rm -f server
	@rm -f ./test/client
	@rm -f ./tests/store_test
	@rm -f ./tests/kv_bench
	@rm -f ./tests/perf_test
	@rm -f ./tests/server_smoke.log
	@rm -f ./tests/perf_server.log
.PHONY: all clean test smoke-test perf-test network-test compare-redis
EOF

echo "Makefile created successfully."
